# Copier ce fichier en .env.local et le remplir. Ne jamais committer .env.local.

# Base MySQL Hostinger (hPanel > Bases de données > MySQL).
# Sur l'hébergement Hostinger lui-même, l'hôte est généralement « localhost ».
# En développement local, activer « MySQL distant » pour votre IP dans hPanel et utiliser l'hôte indiqué.
DATABASE_URL=mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:3306/u506684809_MawazoH

# Dossier persistant où sont enregistrées les images envoyées depuis l'admin.
# Doit se trouver HORS du dossier de l'application (sinon effacé à chaque déploiement).
UPLOAD_DIR=./uploads

# Adresse publique du site (liens, Open Graph, e-mails de réinitialisation).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Premier compte administrateur, créé par « npm run db:seed » puis inutile.
# Le mot de passe peut être changé ensuite depuis l'admin.
SEED_OWNER_EMAIL=
SEED_OWNER_NAME=
SEED_OWNER_PASSWORD=
